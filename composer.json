{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "funseco/live-rankings-plugin",
    "description": "Funseco live rankings plugin — in-race score tracking, live-rankings widget",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "funseco/core": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Funseco\\LiveRankings\\": "src/"
        }
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Funseco\\LiveRankings\\Tests\\": "tests/"
        }
    },
    "extra": {
        "funseco": {
            "id": "live-rankings",
            "name": "Live Rankings",
            "description": "live rankings plugin — in-race score tracking, live-rankings widget",
            "provider": "Funseco\\LiveRankings\\LiveRankingsServiceProvider"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
